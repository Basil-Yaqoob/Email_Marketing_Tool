# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every key here maps 1:1 to a field in app/core/config.py:Settings.
# Required keys have no defaults: the app raises MissingConfigError (or a
# Pydantic ValidationError at startup) rather than falling back to anything.

# --- Required ----------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml's postgres service
# by default: postgresql+asyncpg://emt:emt_dev_password@localhost:5433/email_marketing_tool
# Host port is 5433, not Postgres's usual 5432 -- see the comment in
# docker-compose.yml. If nothing else on your machine holds 5432, you can
# still point this at 5432 after changing the port mapping there too.
DATABASE_URL=

# Redis connection string, used by arq for the job queue.
REDIS_URL=redis://localhost:6379/0

# Symmetric key used to encrypt stored mailbox credentials at rest (Session 14).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Optional: LLM providers (Session 11) -------------------------------------
# The gateway degrades explicitly when a provider key is absent — it does not
# fall back to a hardcoded value. At least one is needed to generate copy.

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Optional: paid data sources (Sessions 05, 07) ----------------------------
# Free sources (OSM, Companies House free tier, etc.) run first regardless.
# These only matter once the free waterfall tier leaves confidence below
# threshold — see CLAUDE.md rule 2.3.

GOOGLE_MAPS_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=

# --- Tunables (safe defaults in code; override only if you know why) ---------

ERROR_RATE_THRESHOLD=0.05
CONFIDENCE_THRESHOLD=0.85
HTTP_CACHE_DIR=.http_cache
LOG_LEVEL=INFO
